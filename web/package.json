{
  "name": "mosaico-do-tempo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build ../engine --target web --out-dir ../web/src/wasm --out-name mosaico_engine --release && node -e \"require('fs').rmSync('src/wasm/.gitignore',{force:true})\"",
    "config:sync": "node scripts/sync-config.mjs",
    "check:wasm-freshness": "node scripts/check-wasm-freshness.mjs",
    "predev": "npm run wasm:build && npm run config:sync",
    "dev": "vite",
    "dev:host": "vite --host",
    "prebuild": "npm run wasm:build && npm run config:sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3"
  }
}
